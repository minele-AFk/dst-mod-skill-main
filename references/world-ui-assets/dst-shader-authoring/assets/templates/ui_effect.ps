#if defined(GL_ES)
precision mediump float;
#endif

uniform sampler2D SAMPLER[1];
uniform vec4 IMAGE_PARAMS;

varying vec2 PS_TEXCOORD;
varying vec4 PS_COLOUR;

void main()
{
    vec4 colour = texture2D(SAMPLER[0], PS_TEXCOORD) * PS_COLOUR;

    // IMAGE_PARAMS.x = time, IMAGE_PARAMS.y = strength in [0, 1].
    float pulse = 0.5 + 0.5 * sin(IMAGE_PARAMS.x * 4.0);
    vec3 tint = mix(vec3(1.0), vec3(0.35, 0.85, 1.0), pulse);
    colour.rgb = mix(colour.rgb, colour.rgb * tint, IMAGE_PARAMS.y);

    gl_FragColor = colour;
}
